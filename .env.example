# Application
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# SQLite
DATABASE_URL=file:./data/app.db

# Autonomous scan interval
SCAN_INTERVAL_MINUTES=30

# AI provider configuration
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=M3

# Source retrieval
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=

# Optional future discovery; leave unset for the initial demo
EXA_API_KEY=

# Demo safety
DEMO_MODE=true
AUTO_PUBLISH_ENABLED=false
