# Application
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# SQLite
DATABASE_URL=file:./data/app.db

# Autonomous scan interval and cost limits
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=30
SCAN_MAX_URLS=10
FETCH_TIMEOUT_MS=30000
FETCH_MAX_CONTENT_BYTES=5000000

# Local demo administration; must not be exposed publicly
ADMIN_API_ENABLED=true

# AI provider configuration
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=M3

# Source retrieval
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=

# Optional future discovery; leave unset for the initial demo
EXA_API_KEY=

# Demo safety
DEMO_MODE=true
AUTO_PUBLISH_ENABLED=false
